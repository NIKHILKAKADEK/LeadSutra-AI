# Restart the backend after editing .env. Process environment variables take precedence.
# Discovery uses Google Places and/or the existing Google Maps browser scraper.
GOOGLE_PLACES_API_KEY=
# Optional legacy alternative to GOOGLE_PLACES_API_KEY; no key is needed by the browser scraper.
GOOGLE_MAPS_API_KEY=
LEADSUTRA_ENABLE_GOOGLE_PLACES=true
LEADSUTRA_ENABLE_MAPS_BROWSER=true
# Allow browser fallback on retryable Places failures (missing-key fallback already uses the Maps master switch).
LEADSUTRA_ENABLE_MAPS_BROWSER_FALLBACK=false
# Also fall back when Places returns zero results; requires the fallback switch above.
LEADSUTRA_MAPS_FALLBACK_ON_ZERO_RESULTS=false
LEADSUTRA_PLACES_MAX_ATTEMPTS=2
LEADSUTRA_PLACES_TIMEOUT_SECONDS=15
LEADSUTRA_PLACES_RETRY_DELAY_SECONDS=0.15

# Voice provider: OmniDimension. False keeps the existing dry-run dispatch behavior.
OMNIDIM_API_KEY=
OMNIDIM_OUTBOUND_AGENT_ID=261506
OUTBOUND_CALLS_ENABLED=false
OUTBOUND_CALL_PURPOSE=commercial_sales_call
OUTBOUND_REPRESENTED_BUSINESS_NAME=
OUTBOUND_REPRESENTED_BUSINESS_IDENTITY_VERIFIED=false
# Set your own admin token (at least 32 characters). Reviewer token is optional.
ELIGIBILITY_ADMIN_TOKEN=
ELIGIBILITY_REVIEWER_TOKEN=

# Email provider: authenticated SMTP. False blocks sending; previews remain available.
EMAIL_SENDING_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=15
# For implicit TLS use SMTP_SECURITY=ssl and your provider's SSL port (usually 465).

# Optional storage overrides; commented values use the backend's existing defaults.
# LEAD_JSON_PATH=D:/Projects/leadsutra_scraper/backend/app/results/leads
# PROPOSAL_ROOT=D:/Projects/leadsutra_scraper/backend/app/results/proposals
# ELIGIBILITY_DB_PATH=D:/Projects/leadsutra_scraper/backend/app/results/calls/calling_eligibility.sqlite3
# EMAIL_DB_PATH=D:/Projects/leadsutra_scraper/backend/app/results/emails/emails.sqlite3

# Website extraction and scoring run locally; no separate LLM API key is used.
