# LeadSutra AI — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ── Lead Discovery ──────────────────────────────────────────────────────────
# Google Maps / Places API key for business lead discovery (primary provider).
# Required for the GooglePlacesProvider to function.
# Get yours at: https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_MAPS_API_KEY=

# Alternative env-var name (either is accepted; GOOGLE_MAPS_API_KEY takes priority).
# GOOGLE_PLACES_API_KEY=

# Foursquare Places API key for business lead discovery (fallback provider).
# Get yours at: https://foursquare.com/developers/
FOURSQUARE_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens.  Use a long random string in production.
# JWT_SECRET_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
# SMTP credentials for cold email automation.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ── Voice Outreach ────────────────────────────────────────────────────────────
# OmniDimension API credentials for AI voice SDR.
# OMNIDIMENSION_API_KEY=

# ── AI Services ──────────────────────────────────────────────────────────────
# Google Gemini API key for cloud-based LLM processing.
# GEMINI_API_KEY=
