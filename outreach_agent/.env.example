# Copy this file to .env and adjust values for your environment.
APP_NAME=LeadSutra AI Backend
ENVIRONMENT=development
API_VERSION=v1
API_PREFIX=/api/v1
# Pydantic Settings parses list values as JSON.
CORS_ORIGINS=["http://localhost:3000"]
OMNIDIM_API_KEY=
OMNIDIM_OUTBOUND_AGENT_ID=261506
OUTBOUND_CALLS_ENABLED=false
OUTBOUND_CALL_PURPOSE=commercial_sales_call
# Set the identity only after an authorized owner has verified the represented business.
OUTBOUND_REPRESENTED_BUSINESS_NAME=
OUTBOUND_REPRESENTED_BUSINESS_IDENTITY_VERIFIED=false

# Override to read leads from another configured source file.
LEAD_JSON_PATH=D:\Leadsutra_AI\leads.json

# Configure distinct long, random tokens before enabling eligibility endpoints.
ELIGIBILITY_ADMIN_TOKEN=
ELIGIBILITY_REVIEWER_TOKEN=
ELIGIBILITY_DB_PATH=data/calling_eligibility.sqlite3

